rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Donors collection:
    // Anyone can read donors and self-register as a new blood donor.
    // Only authenticated admins can update or delete donor records.
    match /donors/{donorId} {
      allow read, create: if true;
      allow update, delete: if request.auth != null;
    }
    
    // App settings: Anyone can read (for 90-day calculation); Only admins can update
    match /app_settings/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Admin profiles: Authenticated admins only
    match /admin_profiles/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
