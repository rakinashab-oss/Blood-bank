rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Public visitors can read donors; Only authenticated admins can write/delete
    match /donors/{donorId} {
      allow read: if resource.data.is_public == true || request.auth != null;
      allow write, delete: if request.auth != null;
    }
    
    // Anyone can read app settings (donation interval); Admins can update
    match /app_settings/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Admin profiles: Only authenticated admins can view and update
    match /admin_profiles/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
