rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Public visitors can read donors & self-register as a blood donor; Only authenticated admins can update or delete
    match /donors/{donorId} {
      allow read: if resource.data.is_public == true || request.auth != null;
      allow create: if request.resource.data.full_name is string 
                    && request.resource.data.phone_number is string
                    && request.resource.data.blood_group is string;
      allow update, delete: if request.auth != null;
    }
    
    // Anyone can read app settings (donation interval); Admins can update
    match /app_settings/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Admin profiles: Only authenticated admins can view and update
    match /admin_profiles/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
